# Copia este fichero a .env y ajusta los valores. Nunca subas .env al repositorio.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# URL pública con la que se construyen enlaces absolutos
API_IDEE_PUBLIC_URL=http://localhost:8000/

# Catálogo estático de recursos SVG y geodatos
API_IDEE_STATIC_RESOURCES_URL=https://componentes.idee.es/estaticos

# Plugins externos: vacío = solo snapshot local (sin red); en producción, URL real
API_IDEE_EXTERNAL_PLUGINS_BASE_URL=
API_IDEE_EXTERNAL_PLUGINS_ALLOWED_HOSTS=*.idee.es,*.ign.es,*.cnig.es
API_IDEE_EXTERNAL_PLUGINS_TTL=300
API_IDEE_EXTERNAL_PLUGINS_TIMEOUT=5
API_IDEE_EXTERNAL_PLUGINS_MAX_BYTES=2097152

# Caché de catálogo y recursos (segundos)
API_IDEE_CATALOG_MAX_AGE=300
API_IDEE_RESOURCE_MAX_AGE=86400
API_IDEE_PLUGIN_ASSET_MAX_AGE=3600

# CORS: orígenes permitidos separados por comas (vacío = ninguno)
CORS_ALLOWED_ORIGINS=

# Proxy (SSRF): allowlist de hosts y puertos
PROXY_ALLOWED_HOSTS=*.idee.es,*.ign.es,*.cnig.es
PROXY_ALLOWED_PORTS=80,443

# Base de datos de la aplicación (no los datasources PostGIS)
DATABASE_URL=sqlite:///db.sqlite3

# Logs: console | json
LOG_LEVEL=INFO
LOG_FORMAT=console

# SMTP (fase 6)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=mail-cnig-noreply@cnig.es
